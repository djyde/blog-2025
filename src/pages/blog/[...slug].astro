---
import dayjs from 'dayjs';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import PageLayout from '@/components/layouts/PageLayout.astro';
import ArticleJsonLd from '@/components/json-ld/article.astro';
import AffixTitle from '@/components/affix-title';
import Toc from '@/components/toc';
import CodeGroupEvent from '@/components/code-group-event';
import slateConfig from '~@/slate.config';
import { getFullTitle } from '@/helpers/utils';
import 'remark-block-containers/css';

import BlogFooter from '@/content/blog-footer.md';

export async function getStaticPaths() {
  const postEntries = await getCollection('post', ({ data }) => {
    return import.meta.env.DEV || data.draft !== true;
  });

  return postEntries.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'post'>;

const post = Astro.props;
const { Content, remarkPluginFrontmatter, headings } = await render(post);
const lastModifiedDate = dayjs(
  remarkPluginFrontmatter.lastModified
    ? remarkPluginFrontmatter.lastModified
    : undefined,
);
const lastModified = lastModifiedDate.isSame(dayjs(), 'year')
  ? lastModifiedDate.format('M月D日')
  : lastModifiedDate.format('YYYY年M月D日');
const pubDate = dayjs(post.data.pubDate);
const formattedPubDate = pubDate.isSame(dayjs(), 'year')
  ? pubDate.format('M月D日')
  : pubDate.format('YYYY年M月D日');
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  image={post.data.ogImage}
>
  <ArticleJsonLd
    slot="json-ld"
    title={getFullTitle(post.data.title)}
    description={post.data.description}
    pubDate={post.data.pubDate}
    lastModified={lastModifiedDate.toDate()}
  />
  <CodeGroupEvent client:only="react" />
  <AffixTitle title={post.data.title} offsetTop={100} client:only="react" />

  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_200px] lg:gap-12 lg:-mr-56">
    <article class="w-full">
      <div class="mb-10 pt-8">
        <h1 class="text-3xl font-semibold leading-tight md:text-4xl">{post.data.title}</h1>
        <div class="mt-3 flex items-center gap-2 text-sm text-olive-10">
          <span>{formattedPubDate}</span>
          {!!slateConfig.readTime && <span>·</span>}
          {slateConfig.readTime && <span>{remarkPluginFrontmatter.minutesRead}</span>}
        </div>
      </div>
      <div class="prose-blog blog-content">
        <Content />
        {slateConfig.lastModified && <div class="text-olive-10">编辑于 {lastModified}</div>}
        <hr />
        <div class="sponsor">
          <BlogFooter />
        </div>
      </div>
    </article>
    <!-- S 目录 -->
    <Toc
      className="sticky top-16 hidden max-h-[calc(100dvh-8rem)] self-start text-sm lg:block"
      listClassName="pb-14"
      dataSource={headings}
      client:visible
    />
    <!-- E 目录 -->
  </div>
</PageLayout>

<script src="//unpkg.com/heti/umd/heti-addon.min.js" is:inline></script>
<script>
  const heti = new Heti('.blog-content');
  heti.autoSpacing();
</script>
