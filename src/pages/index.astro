---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import dayjs from 'dayjs';
import Intro from '@/content/intro.md';
import PageLayout from '@/components/layouts/PageLayout.astro';
import alibaba from '@/assets/logos/alibaba.svg?raw';
import huya from '@/assets/logos/huya.svg?raw';
import antgroup from '@/assets/logos/antgroup.svg?raw';
import microsoft from '@/assets/logos/microsoft.svg?raw';
import lamp from '@/assets/riso/lamp.jpg';
import { getCover } from '@/helpers/cover';

const postCollection = await getCollection('post', ({ data }) => {
  return import.meta.env.DEV || data.draft !== true;
});

const posts = [...postCollection]
  .sort((a, b) => b.data.pubDate!.getTime() - a.data.pubDate!.getTime())
  .map((post) => ({
    id: post.id,
    url: `/blog/${post.id}`,
    data: post.data,
    date: dayjs(post.data.pubDate).format('YYYY.MM.DD'),
    cover: getCover(post.id),
  }));

const products = [
  { name: 'Nowdex', href: 'https://nowdex.app' },
  { name: 'Notepal', href: 'https://notepal.randynamic.org' },
  { name: 'Browserfly', href: 'https://browserfly.app' },
  { name: 'EpubKit', href: 'https://epubkit.app/' },
];

const companies = [
  { name: 'Alibaba', logo: alibaba },
  { name: '虎牙直播', logo: huya },
  { name: '蚂蚁金服', logo: antgroup },
  { name: '微软中国', logo: microsoft },
];
---

<PageLayout>
  <section class="grid items-center gap-6 pb-12 pt-2 sm:pt-8 sm:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)]">
    <div>
      <div class="flex items-center gap-4">
        <img src="/avatar.jpg" alt="Randy Lu" class="size-14 shrink-0 rounded-full object-cover object-[50%_35%]" />
        <h1 class="text-2xl font-semibold">Randy Lu</h1>
      </div>
      <p class="mt-4 text-olive-11">Product Engineer，写作者。记录关于生活、技术与阅读的思考。</p>
      <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-olive-11">
        {
          products.map((product) => (
            <a href={product.href} target="_blank" rel="noopener" class="hover:text-olive-12">
              {product.name} ↗
            </a>
          ))
        }
      </div>
    </div>
    <Image
      src={lamp}
      alt=""
      widths={[400, 800]}
      sizes="(min-width: 640px) 340px, 80vw"
      class="order-first mx-auto -mb-6 w-4/5 sm:order-none sm:mx-0 sm:mb-0 sm:w-full [mask-image:radial-gradient(ellipse_60%_70%_at_62%_55%,#000_50%,transparent_100%)]"
      loading="eager"
    />
  </section>

  <section class="pb-16">
    <h2 class="section-title">Worked at</h2>
    <ul class="mt-4 flex flex-wrap gap-x-8 gap-y-3 text-olive-11">
      {
        companies.map((company) => (
          <li class="flex items-center gap-2">
            <span class="size-5 [&>svg]:size-full" set:html={company.logo} />
            {company.name}
          </li>
        ))
      }
    </ul>
  </section>

  <section id="about" class="pb-16">
    <h2 class="section-title">About</h2>
    <div class="prose-blog mt-4 text-base text-olive-11">
      <Intro />
    </div>
  </section>

  <!-- 文章列表突破正文栏宽度，最宽 max-w-6xl、最多 4 列 -->
  <section id="writing" class="mx-[calc(50%-50vw)] px-6 md:px-10 lg:px-16">
    <div class="mx-auto max-w-6xl">
      <h2 class="section-title">Writing</h2>
      <ul class="mt-6 grid grid-cols-1 gap-y-10 sm:grid-cols-3 sm:gap-x-10 sm:gap-y-14 lg:grid-cols-4">
        {
          posts.map((post, index) => (
            <li>
              <a href={post.url} title={post.data.title} class="group block">
                {post.cover ? (
                  <div class="overflow-hidden">
                    <Image
                    src={post.cover}
                    alt=""
                    widths={[320, 640]}
                    sizes="(min-width: 1280px) 260px, (min-width: 1024px) 23vw, (min-width: 640px) 30vw, 100vw"
                    class="riso-fade aspect-[16/9] w-full object-cover transition-transform duration-300 group-hover:-translate-y-0.5 sm:aspect-[4/3]"
                  />
                  </div>
                ) : (
                  <div class="aspect-[16/9] w-full sm:aspect-[4/3]" />
                )}
                <div class="mt-1 text-base font-medium sm:text-[0.9375rem] leading-snug text-balance group-hover:underline group-hover:decoration-lamp group-hover:underline-offset-4">
                  {post.data.title}
                </div>
                <div class="mt-1 flex items-center gap-1.5 text-xs text-olive-9 tabular-nums">
                  {index === 0 && <span class="size-1.5 rounded-full bg-lamp shadow-[1px_1px_0_var(--color-rust)]" />}
                  {post.date}
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</PageLayout>
