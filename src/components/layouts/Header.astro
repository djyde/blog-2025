---
import slateConfig from '~@/slate.config';

const links = [
  { label: 'Writing', href: '/#writing' },
  { label: 'About', href: '/#about' },
  ...(slateConfig.navigations ?? []).map(({ label, href }) => ({ label, href })),
];
---

<header class="flex items-center justify-between py-6">
  <a href="/" class="font-medium">Randy Lu</a>
  <nav class="flex gap-5 text-sm text-olive-11">
    {links.map((link) => <a href={link.href} class="hover:text-olive-12">{link.label}</a>)}
  </nav>
</header>
